    "burst": {
      "display": "BURST FINISH",
      "japanese": "バーストフィニッシュ",
      "points": 2,
      "definition": "在自己的陀螺之前，對手的零件脫落並分離。",
      "required_evidence": ["opponent_parts_separated", "first_event=burst"]
    },
    "spin": {
      "display": "SPIN FINISH",
      "japanese": "スピンフィニッシュ",
      "points": 1,
