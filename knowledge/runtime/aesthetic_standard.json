  "presentation_grammars": {
    "ai_evidence_canvas": {
      "status": "positive_user_reference_2026-08-12",
      "scope": ["ai", "technology", "business", "education"],
      "use_when": [
        "three or more real visual evidence assets",
        "the explanation depends on relationships among files, prompts, interfaces or outputs",
        "a shared spatial canvas reduces cognitive reorientation"
      ],
      "avoid_when": [
        "talking head or real-world footage is the primary evidence",
        "continuous cursor and button visibility is required",
        "there is no real evidence beyond abstract labels"
      ],
      "states": ["hero_result", "asset_cluster", "focus_evidence", "compare_or_sequence", "full_bleed_payoff"],
      "invariants": [
        "outcome first",
        "one active focus",
        "zoom encodes hierarchy",
        "real operation and payoff take over full screen",
        "grid is optional spatial scaffolding and never an automatic opener",
        "no empty title or transition cards"
      ],
      "token_contract": "Planner emits grammar, theme, evidence IDs, focus target and state sequence; renderer owns layout, safe area and motion timing."
    }
