{
  "schema_version": 1,
  "standard_id": "hao-aesthetic-standard",
  "version": "2.0.0",
  "reference_basis": {
    "private_reference_count": 33,
    "dna_file": "knowledge/design_reference_dna.json",
    "compiler": "design_system_v6.py",
    "method": "Abstract composition, typography, colour, image integration, material and motion principles only; never redistribute or copy the reference artwork.",
    "shared_dna": [
      "one dominant focal idea per frame",
      "clear scale contrast and asymmetric editorial hierarchy",
      "bright high-contrast colour with disciplined accents",
      "subject integrated into the layout instead of pasted on top",
      "type treated as image while remaining readable",
      "small marks, texture and material detail used to finish rather than clutter",
      "motion inherits the still design hierarchy and has a narrative reason",
      "MrBeast information energy and 影視颶風 cinematic craft are scored as benchmarks, never copied as a surface skin"
    ]
  },
  "principles": {
    "more_design_is_not_more_beautiful": true,
    "semantic_fit_precedes_decoration": true,
    "restraint_is_a_positive_signal": true,
    "reference_copying_is_not_style_learning": true,
    "real_footage_remains_primary": true,
    "grid_is_support_texture_not_default_opener": true,
    "machine_checks_block_known_failures_humans_score_taste": true,
    "mrbeast_and_yingshi_hurricane_are_formal_benchmarks": true,
    "benchmarks_apply_to_every_longform_and_shortform_route": true,
    "capability_parity_not_frame_identical_copying": true,
    "never_claim_100_percent_effect_reproduction_without_effect_level_evidence": true
  },
  "dimensions": {
    "semantic_fit": {
      "label_zh": "題材與概念貼合",
      "weight": 12,
      "question": "這套視覺是否讓人不看標題也能感到題材、情緒與內容目的？"
    },
    "focal_hierarchy": {
      "label_zh": "焦點與構圖層級",
      "weight": 12,
      "question": "第一眼焦點是否唯一，主次、留白、比例與視線動線是否清楚？"
    },
    "typography": {
      "label_zh": "字體與文字編排",
      "weight": 12,
      "question": "字體是否有角色、大小對比、斷行與中英數品質，且沒有切字或罐頭感？"
    },
    "colour_contrast": {
      "label_zh": "色彩與對比",
      "weight": 9,
      "question": "主色、強調色、明暗與膚色是否協調，亮而不髒、醒目但不互搶？"
    },
    "subject_integration": {
      "label_zh": "主體與素材整合",
      "weight": 12,
      "question": "人物、物件、照片、圖形與背景是否共享光影、景深、遮擋和空間關係？"
    },
    "temporal_design": {
      "label_zh": "動態、節奏與時間設計",
      "weight": 13,
      "question": "進出場、Tracking、轉場與停頓是否跟內容節拍一致，而非展示特效？"
    },
    "finish_material": {
      "label_zh": "材質與完成度",
      "weight": 7,
      "question": "邊緣、陰影、顆粒、光暈、掃描紋與微細節是否精緻且服務風格？"
    },
    "originality_consistency": {
      "label_zh": "原創性與系統一致",
      "weight": 3,
      "question": "是否保留 Hao 的識別與該片一致性，又沒有照抄參考圖或重複上一支？"
    },
    "mrbeast_information_energy": {
      "label_zh": "MrBeast 資訊能量",
      "weight": 10,
      "question": "挑戰、主體、數字、勝負與下一步是否一眼讀懂；每次視覺強調是否重新抓回注意力，而不是單純裝飾？"
    },
    "yingshi_hurricane_cinematic_craft": {
      "label_zh": "影視颶風電影工藝",
      "weight": 10,
      "question": "鏡頭運動、剪點、聲音、調色與轉場是否有動機、精準、流暢，並具備完成度與電影感？"
    }
  },
  "format_multipliers": {
