  "format_rules": {
    "shorts": {
      "roles": ["first-frame overlay", "tracked label", "selective giant type", "payoff accent"],
      "rule": "Real footage first; type and graphics may be bold but must preserve one focal hierarchy."
    },
    "longform": {
      "roles": ["chapter identity", "proof annotation", "selective hero number", "clean lower third"],
      "rule": "Use the style family as punctuation, not as a permanent decorative skin; regular subtitles stay restrained."
    }
  },
  "presentation_grammars": {
    "ai_evidence_canvas": {
      "status": "positive_user_reference_2026-08-12",
      "scope": ["ai", "technology", "business", "education"],
      "use_when": [
        "three or more real visual evidence assets",
        "the explanation depends on relationships among files, prompts, interfaces or outputs",
        "a shared spatial canvas reduces cognitive reorientation"
      ],
      "avoid_when": [
        "talking head or real-world footage is the primary evidence",
        "continuous cursor and button visibility is required",
        "there is no real evidence beyond abstract labels"
      ],
      "states": ["hero_result", "asset_cluster", "focus_evidence", "compare_or_sequence", "full_bleed_payoff"],
      "invariants": [
        "outcome first",
        "one active focus",
        "zoom encodes hierarchy",
        "real operation and payoff take over full screen",
        "grid is optional spatial scaffolding and never an automatic opener",
        "no empty title or transition cards"
      ],
      "token_contract": "Planner emits grammar, theme, evidence IDs, focus target and state sequence; renderer owns layout, safe area and motion timing."
    }
  },
  "machine_block_signals": {
    "generic_fullscreen_card": "Generic template replaces story evidence.",
    "grid_used_as_default_opener": "Grid is used as an automatic opener.",
    "template_role_label_visible": "Template metadata leaks into the edit.",
    "unmotivated_geometric_transition": "A geometric transition has no shot or narrative motivation.",
    "text_safe_area_pass=false": "Text is clipped or outside the safe area.",
    "style_domain_match=false": "The selected style family conflicts with the subject.",
    "exact_reference_layout_copy": "The layout copies a reference instead of abstracting its principles.",
    "visual_density_overload": "Too many simultaneous focal elements erase hierarchy."
  }
