{
  "exclude": [
    ".git/**",
    ".rd/**",
    "dist*/**",
    "**/__pycache__/**",
    "**/_runtime/**",
    "**/reference_impl_*/**",
    "codex-skill/video-autopilot/workflow_contract.py",
    "codex-skill/video-autopilot/workflow_material_receipts.py",
    "codex-skill/video-autopilot/workflow_receipts.py",
    "codex-skill/video-autopilot/workflow_state.py",
    "codex-skill/video-autopilot/workflow_transport.py",
    "tools/code-cleanup-helper/**"
  ],
  "architecture": {
    "enabled": true,
    "layers": [
      {
        "name": "asset_foundation",
        "patterns": [
          "src/project_paths.py",
          "src/domain_taxonomy.py",
          "src/asset_usage.py",
          "src/asset_index_migration.py",
          "src/asset_registry_shared.py"
        ],
        "may_depend_on": []
      },
      {
        "name": "asset_query",
        "patterns": [
          "src/asset_catalog.py",
          "src/asset_selection.py"
        ],
        "may_depend_on": [
          "asset_foundation"
        ]
      },
      {
        "name": "asset_application",
        "patterns": [
          "src/asset_registry.py"
        ],
        "may_depend_on": [
          "asset_foundation",
          "asset_query"
        ]
      },
      {
        "name": "asset_compatibility",
        "patterns": [
          "src/asset_memory.py"
        ],
        "may_depend_on": [
          "asset_foundation",
          "asset_query",
          "asset_application"
        ]
      }
    ],
    "forbidden_dependencies": [
      {
        "source": "src/asset_usage.py",
        "target": "src/asset_registry.py",
        "message": "Usage persistence must not depend on the registry application boundary"
      },
      {
        "source": "src/asset_index_migration.py",
        "target": "src/asset_registry.py",
        "message": "Index migration must remain independent from the registry application boundary"
      },
      {
        "source": "src/asset_catalog.py",
        "target": "src/asset_registry.py",
        "message": "Catalog queries must not depend on the registry facade"
      }
    ],
    "required_dependencies": [
      {
        "source": "src/tracked_graphics.py",
        "target": "src/tracked_graphics_presentation.py",
        "message": "Tracked-graphics facade must retain the extracted presentation boundary"
      },
      {
        "source": "src/tracked_graphics.py",
        "target": "src/tracked_graphics_render.py",
        "message": "Tracked-graphics facade must retain the extracted render boundary"
      },
      {
        "source": "src/longform_maker/shorts_gate.py",
        "target": "src/longform_maker/shorts_gate_validation.py",
        "message": "Shorts gate facade must retain the extracted validation boundary"
      },
      {
        "source": "src/publish_hub.py",
        "target": "src/publish_hub_cli.py",
        "message": "Publish hub facade must retain the extracted CLI boundary"
      },
      {
        "source": "src/shorts_autopilot.py",
        "target": "src/publish_hub.py",
        "message": "A completed Shorts build must commit through the single publishing control plane"
      },
      {
        "source": "src/longform_maker/delivery.py",
        "target": "src/publish_hub.py",
        "message": "A completed long-form build must commit through the single publishing control plane"
      }
    ],
    "ignore_edges": [],
    "function_warning_lines": 80,
    "function_severe_lines": 160,
    "function_exceptions": [
      {
        "path": "src/silent_vlog_maker/verify.py",
        "name": "run_verify_steps",
        "max_lines": 200,
        "reason": "Ordered verification transaction with one failure ledger",
        "expires_on": "2026-12-31"
      },
      {
        "path": "src/silent_vlog_maker/audit.py",
        "name": "audit_raw_files",
        "max_lines": 165,
        "reason": "Single media audit adapter around ffprobe and frame evidence",
        "expires_on": "2026-12-31"
      },
      {
        "path": "src/longform_maker/word_captions.py",
        "name": "group_words",
        "max_lines": 150,
        "reason": "One timing and segmentation algorithm with coupled invariants",
        "expires_on": "2026-12-31"
      },
      {
        "path": "src/shorts_autopilot.py",
        "name": "scan",
        "max_lines": 150,
        "reason": "Compatibility orchestration entrypoint; production helpers remain independently tested",
        "expires_on": "2026-12-31"
      }
    ],
    "module_hotspot_exceptions": [
      {
        "path": "src/project_paths.py",
        "max_fan_in": 30,
        "max_out_degree": 0,
        "reason": "Stable dependency-free path foundation; central discovery prevents duplicated machine-path logic",
        "expires_on": "2026-12-31"
      }
    ],
    "max_module_out_degree": 18,
    "max_module_fan_in": 24,
    "duplicate_function_min_lines": 8,
    "duplicate_function_min_nodes": 24
  }
}
