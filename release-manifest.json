      "target_maximum_exclusive": "0.26.0",
      "idempotent": true,
      "automatic": false,
      "notes": "v0.25.0 removes the legacy FFmpeg render, motion and Shorts runtimes that older entry points re-execute after an automatic update; upgrade explicitly, then start new work through the Editkin v4 workflow."
    },
    {
      "id": "compatible-window-v025",
      "from_minimum": "0.25.0",
      "from_maximum_exclusive": "0.26.0",
